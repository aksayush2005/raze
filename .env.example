# ---------------------------------------------------------------------------
# RAZE environment configuration
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raze
POSTGRES_PASSWORD=raze_dev_password
POSTGRES_DB=raze
DATABASE_URL=postgres://raze:raze_dev_password@localhost:5432/raze?sslmode=disable

# --- Go API service ---------------------------------------------------------
API_PORT=8080
API_ENV=dev

# --- Razorpay (TEST MODE ONLY) ----------------------------------------------
# Optional. When unset, RAZE runs fully on synthetic settlement data.
# NEVER use production credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test

# --- Python AI service ------------------------------------------------------
AI_SERVICE_URL=http://localhost:8090

# --- Gemini advisory AI (optional) -------------------------------------------
# When GEMINI_API_KEY is unset, RAZE's AI investigation uses the deterministic
# heuristic-v1 rules (offline demo). When set, each REVIEW/ESCALATE case is also
# advised by the Gemini model below. RAZE_AI_BACKEND: auto (fall back to
# heuristic on any LLM error) | gemini (required, fail closed) | heuristic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
RAZE_AI_BACKEND=auto

# --- Async workflow ---------------------------------------------------------
WORKER_CONCURRENCY=4
